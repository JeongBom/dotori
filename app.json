{
  "expo": {
    "name": "도토리",
    "slug": "dotori",
    "scheme": "dotori",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#FDF6EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bbom16.homemanager",
      "entitlements": {}
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bbom16.homemanager"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "도토리",
      "shortName": "도토리",
      "themeColor": "#8B5E3C",
      "backgroundColor": "#FDF6EC"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "영수증을 촬영해 재고를 등록하기 위해 카메라를 사용합니다.",
          "photosPermission": "영수증 사진을 선택하기 위해 앨범에 접근합니다."
        }
      ]
    ],
    "owner": "bbom16",
    "extra": {
      "eas": {
        "projectId": "72d90ea3-ff0d-4006-b440-e00abfa69ac5"
      }
    }
  }
}
